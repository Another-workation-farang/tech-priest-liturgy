{
  "name": "liturgy-syntax",
  "displayName": "Liturgy",
  "description": "Syntax highlighting for Liturgy, the superset of Python spoken in the ritual tongue of the Adeptus Mechanicus.",
  "version": "0.1.0",
  "publisher": "tech-priest-liturgy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Another-workation-farang/tech-priest-liturgy"
  },
  "engines": {
